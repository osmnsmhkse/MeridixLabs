# Copy this file to .env.local and fill in your values

# ── Anthropic (existing) ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Resend (existing) ──────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── Clerk (auth) ───────────────────────────────────────────────────
# Create a Clerk app at https://dashboard.clerk.com
# Enable Google, Apple, and Email (magic link / code) in "User & Authentication"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile?welcome=1

# ── Supabase (database) ────────────────────────────────────────────
# Create a project at https://supabase.com — run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
