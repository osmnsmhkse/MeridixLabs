# Copy this file to .env.local and fill in your values

# ── Anthropic (existing) ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Resend (existing) ──────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── SEO: Google Search Console verification ────────────────────────
# In Search Console → add property www.meridixlabs.com → choose the
# "HTML tag" method and paste ONLY the content="..." token here.
# Leave blank if you verify via DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Admin dashboards (/admin/feedback, /admin/analytics) ───────────
# Password protecting the internal admin pages. Set a strong value.
ADMIN_PASSWORD=choose_a_strong_password

# ── Clerk (auth) ───────────────────────────────────────────────────
# Create a Clerk app at https://dashboard.clerk.com
# Enable Google, Apple, and Email (magic link / code) in "User & Authentication"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile?welcome=1
# Signing secret for the Clerk webhook (Clerk Dashboard → Webhooks → your
# endpoint). Powers the "Total Sign-ups" metric on /admin/analytics.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_signing_secret

# ── Supabase (database) ────────────────────────────────────────────
# Create a project at https://supabase.com — run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Voyage AI (RAG embeddings) ─────────────────────────────────────
# Used by the Lab Analyzer's knowledge retrieval layer and by the
# ingestion script (scripts/ingest-knowledge.ts). Get a key at
# https://dash.voyageai.com — the embedding model is `voyage-3-large`
# (1024 dim). If unset, retrieval is skipped and the analyzer falls
# back to its previous ungrounded behavior.
VOYAGE_API_KEY=your_voyage_api_key_here

# ── NCBI / PubMed E-utilities (optional) ────────────────────────────
# Powers the "Related Studies & Articles" feature (src/lib/pubmed.ts).
# PubMed works WITHOUT a key at 3 requests/sec. Adding a free key from
# https://www.ncbi.nlm.nih.gov/account/settings/ raises the limit to
# 10 req/sec and the service throttles accordingly. Leave blank to use
# the unauthenticated rate limit.
NCBI_API_KEY=

# ── Upstash Redis (rate limiting) ──────────────────────────────────
# Powers per-IP / per-user rate limiting on the AI + email + write API
# routes (src/lib/ratelimit.ts). REQUIRED to actually enforce limits —
# if these are unset, limiting fails OPEN (requests pass through) and a
# warning is logged in production. Provision a free database at
# https://console.upstash.com (or add Vercel's Upstash marketplace
# integration, which sets these two vars automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
